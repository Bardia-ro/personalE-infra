# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Plan output
*.tfplan


# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Provider lock file (optional to ignore if you want consistency across teams)
.terraform.lock.hcl

# IDE and OS files (optional but recommended)
# VSCode
.vscode/

# macOS
.DS_Store

# Windows
Thumbs.db
